# Copy to .env.local and fill in. Never commit real secrets.
#   cp .env.example .env.local

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL. Local: http://localhost:3000
# Production: set in Vercel to the live origin (invite / auth links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional FX display helper.
# NEXT_PUBLIC_KRW_TO_USD_RATE=

# Optional: 1 exposes /my/diagnostics in production (otherwise dev-only).
# NEXT_PUBLIC_DIAGNOSTICS=

# Feature flag for the new signup wizard (Signup v2, 2026-08-20).
# `true` exposes /signup and the redesigned login surface; `false`
# keeps the existing /onboarding + /login flow. Will ramp 10% → 100%
# during Phase 6 rollout — see docs/SIGNUP_REDESIGN_SPEC.md §6.
NEXT_PUBLIC_SIGNUP_V2=false

# --- Mail (delegation / artist invites) ---
# SENDGRID_API_KEY=
# INVITE_FROM_EMAIL=

# --- Theo Image Enhance (Beta) — Object pipeline. Server-only. ---
# --- Display Simulation Phase 2 — Track 2 (advanced painting cutout).
#     Used by /api/ai/artwork-cutout-alpha to produce transparent PNG
#     cutouts of artwork uploads. If unset, Track 1 (free Vision bbox
#     crop) still works; Track 2 returns HTTP 501 with a clear hint.
# PHOTOROOM_API_KEY=

# --- AI (portfolio copilot, drafts, etc.) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_USER_DAILY_SOFT_CAP=30

# --- Theo Board (2026-08-13) ---
# Publish token for Theo Board CLI / Slack (server-only). Generate a long random secret.
THEO_BOARD_PUBLISH_TOKEN=

# Server-only. Used by /api/theo-board/* to write posts. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
